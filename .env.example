# Set these in Vercel > Project > Settings > Environment Variables (never commit a real .env)

# --- required ---
DJANGO_SECRET_KEY=generate-with-python-c-"import secrets;print(secrets.token_urlsafe(60))"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Photos (S3-compatible bucket). Example below is Supabase Storage; see DEPLOY_VERCEL.md
AWS_STORAGE_BUCKET_NAME=media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=PROJECT_REF.supabase.co/storage/v1/object/public/media

# --- after you connect your own domain ---
DJANGO_CANONICAL_HOST=www.yourdomain.in
# DJANGO_ALLOWED_HOSTS=www.yourdomain.in,yourdomain.in     (optional; .vercel.app is always allowed)

# --- payments / email / analytics (optional until you go live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Lala Sarees <you@gmail.com>
GA_MEASUREMENT_ID=

# --- local development only (leave unset on Vercel) ---
# DJANGO_DEBUG=1
